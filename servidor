#!/usr/bin/env python3
import asyncio
from tcp import Servidor
import re

# Argumentos mínimos esperados para cada comando reconhecido pelo servidor
ARGS_ESPERADOS = {
    "NICK": 1,
    "PING": 1,
    "PRIVMSG": 2,
    "JOIN": 1,
    "PART": 1,
}

# Mapeia apelido (em minúsculas) -> conexão correspondente.
NICKS = {}

# Mapeia nome de canal (em minúsculas) -> dicionário com:
#   "nome":    grafia original do canal (a que foi usada no primeiro JOIN)
#   "membros": dicionário apelido_minusculo -> conexao
CANAIS = {}

# Lista de todas as conexões atualmente abertas (registradas ou não)
CONEXOES = []

# Str -> bytes
def sanitize_string_data(dados):
    return dados.decode("utf-8")


def validar_nome(nome):
    return re.match(br'^[a-zA-Z][a-zA-Z0-9_-]*$', nome) is not None


def validar_canal(nome):
    return nome.startswith('#') and validar_nome(nome[1:].encode("utf-8"))

# Envio de linha através da conexão
def enviar_linha(conexao, linha):
    try:
        conexao.enviar((linha + '\r\n').encode("utf-8"))
    except OSError:
        pass

# Se o comando digitado for inválido
def stupid_user(conexao):
    print("Comando desconhecido ou mal formado recebido de", conexao)


def obter_conexoes_em_comum(conexao):
    # Conexões dos usuários que estão em canais em comum  
    conexoes = set()
    for canal_lower in conexao.canais:
        canal = CANAIS.get(canal_lower)
        if canal is None:
            continue
        # Itera sobre todas conexões dos membros de um canal
        for outra_conexao in canal["membros"].values():
            conexoes.add(outra_conexao)
    conexoes.discard(conexao)
    return conexoes


def liberar_nick(conexao):
    nick_lower = conexao.nick.lower()
    # Pega a conexão associada a nick_lower e remove ela, se existir
    if NICKS.get(nick_lower) is conexao:
        del NICKS[nick_lower]


def sair_dos_canais(conexao):
    for canal_lower in list(conexao.canais):
        canal = CANAIS.get(canal_lower)
        if canal is None:
            continue
        # Remove usuário do dicionario de membros de cada canal
        canal["membros"].pop(conexao.nick.lower(), None)
        if not canal["membros"]:
            del CANAIS[canal_lower]
    conexao.canais.clear()

# ---------------------------------------------------------------------------
# HANDLERS DE COMANDOS DO PROTOCOLO
# ---------------------------------------------------------------------------

def nick(conexao, novo_nick):
    """Handler do comando NICK: define o apelido inicial ou troca o apelido atual."""
    apelido_atual = conexao.nick
    novo_nick_lower = novo_nick.lower()

    # Verifica se o apelido escolhido segue o formato válido
    if not validar_nome(novo_nick.encode("utf-8")):
        enviar_linha(conexao, f":server 432 {apelido_atual} {novo_nick} :Erroneous nickname")
        return

    # Verifica se o apelido já está em uso por outra conexão
    if novo_nick_lower in NICKS and NICKS[novo_nick_lower] is not conexao:
        enviar_linha(conexao, f":server 433 {apelido_atual} {novo_nick} :Nickname is already in use")
        return

    registrando_agora = (apelido_atual == '*')

    # Atualiza as estruturas de dados: libera o nick antigo (se houver) e reserva o novo
    liberar_nick(conexao)
    NICKS[novo_nick_lower] = conexao
    conexao.nick = novo_nick

    if registrando_agora:
        # Primeira definição de apelido -> mensagens de boas-vindas, sem aviso de troca
        enviar_linha(conexao, f":server 001 {novo_nick} :Welcome")
        enviar_linha(conexao, f":server 422 {novo_nick} :MOTD File is missing")
    else:
        # Troca de apelido já registrado -> avisa o próprio usuário e quem
        # compartilha algum canal com ele
        mensagem = f":{apelido_atual} NICK {novo_nick}"
        enviar_linha(conexao, mensagem)
        for outra_conexao in obter_conexoes_em_comum(conexao):
            enviar_linha(outra_conexao, mensagem)


def ping(conexao, payload):
    enviar_linha(conexao, f":server PONG server :{payload}")


def privmsg(conexao, destinatario, conteudo):
    """Handler do comando PRIVMSG: envia mensagem privada a outros usuários."""
    mensagem = f":{conexao.nick} PRIVMSG {destinatario} :{conteudo}"

    if destinatario.startswith('#'):
        # Mensagem para um canal: encaminha para todos os membros, exceto o remetente
        canal = CANAIS.get(destinatario.lower())
        if canal is None:
            return  # canal inexistente: ignoramos silenciosamente
        for membro_conexao in canal["membros"].values():
            if membro_conexao is not conexao:
                enviar_linha(membro_conexao, mensagem)
    else:
        # Mensagem para um usuário específico
        destino_conexao = NICKS.get(destinatario.lower())
        if destino_conexao is None:
            return  # apelido inexistente ou não usado no momento: ignoramos
        enviar_linha(destino_conexao, mensagem)


def join(conexao, canal_nome):
    """Handler do comando JOIN: usuário ingressa em um canal."""
    if not validar_canal(canal_nome):
        enviar_linha(conexao, f":server 403 {canal_nome} :No such channel")
        return

    canal_lower = canal_nome.lower()
    canal = CANAIS.setdefault(canal_lower, {"nome": canal_nome, "membros": {}})

    # Registra o usuário no canal (na estrutura do canal e na da própria conexão)
    canal["membros"][conexao.nick.lower()] = conexao
    conexao.canais.add(canal_lower)

    # Avisa o usuário que entrou e todos que já estavam no canal
    mensagem_join = f":{conexao.nick} JOIN :{canal['nome']}"
    for membro_conexao in canal["membros"].values():
        enviar_linha(membro_conexao, mensagem_join)

    # Monta a lista de membros em ordem alfabética, quebrando em várias mensagens
    # 353 sempre que uma linha ultrapassaria 512 caracteres (contando o '\r\n' final)
    membros_ordenados = sorted(c.nick for c in canal["membros"].values())
    prefixo = f":server 353 {conexao.nick} = {canal['nome']} :"
    linha_atual = prefixo

    for membro in membros_ordenados:
        candidata = (linha_atual + membro) if linha_atual == prefixo else (linha_atual + " " + membro)
        if len(candidata) + 2 > 512:  # +2 pelo '\r\n' que enviar_linha vai acrescentar
            enviar_linha(conexao, linha_atual)
            linha_atual = prefixo + membro
        else:
            linha_atual = candidata

    # Envia a última linha montada, exceto se ela ficou vazia (ou seja,
    # igual ao prefixo, o que só aconteceria se o canal não tivesse
    # membros).
    if linha_atual != prefixo:
        enviar_linha(conexao, linha_atual)

    enviar_linha(conexao, f":server 366 {conexao.nick} {canal['nome']} :End of /NAMES list.")


def part(conexao, canal_nome):
    """Handler do comando PART: tira o usuário de um canal específico."""
    canal_lower = canal_nome.lower()
    canal = CANAIS.get(canal_lower)
    # Se o canal não existir ou o usuário não estiver nele, a solicitação
    # é silenciosamente ignorada
    if canal is None or conexao.nick.lower() not in canal["membros"]:
        return  # usuário não estava no canal (ou canal nem existe): ignoramos

    # Todos membros do canal recebem aviso de PART
    mensagem = f":{conexao.nick} PART {canal['nome']}"
    for membro_conexao in canal["membros"].values():
        enviar_linha(membro_conexao, mensagem)

    del canal["membros"][conexao.nick.lower()]
    conexao.canais.discard(canal_lower)
    if not canal["membros"]:
        del CANAIS[canal_lower]


# ---------------------------------------------------------------------------
# Roteamento de mensagens recebidas e ciclo de vida da conexão
# ---------------------------------------------------------------------------

def message_protocol(conexao, command, rest):
    """Confere os argumentos do comando recebido e despacha para o handler certo."""
    esperado = ARGS_ESPERADOS.get(command)

    if esperado is None or len(rest) < esperado:
        return stupid_user(conexao)

    # Mapeia cada comando conhecido para uma lambda que chama o handler correto 
    # já com os argumentos na ordem certa. 
    cases = {
        "NICK": lambda: nick(conexao, rest[0]),
        "PING": lambda: ping(conexao, rest[0]),
        "PRIVMSG": lambda: privmsg(conexao, rest[0], rest[1]),
        "JOIN": lambda: join(conexao, rest[0]),
        "PART": lambda: part(conexao, rest[0]),
    }

    # cases.get(command, ...) retorna a função associada, ou um handler de
    # comando desconhecido caso a chave não exista
    return cases.get(command, lambda: stupid_user(conexao))()


def processar_linha(conexao, linha):
    """Interpreta uma única linha de protocolo (já sem o '\\r\\n') e a despacha."""
    if not linha:
        return

    # Divide em no máximo 3 pedaços: comando, primeiro argumento e "resto"
    # (que pode conter espaços, como o conteúdo de um PRIVMSG)
    palavras = linha.split(' ', 2)
    command = palavras[0]
    rest = palavras[1:]

    # O último argumento de comandos como PRIVMSG/JOIN vem prefixado com ':',
    # que não faz parte do conteúdo em si -> removemos
    if rest and rest[-1].startswith(':'):
        rest[-1] = rest[-1][1:]

    message_protocol(conexao, command, rest)


def sair(conexao):
    """Trata o fechamento de uma conexão: avisa outros usuários e limpa o estado."""
    print(conexao, 'conexão fechada')

    if conexao.nick != '*':
        # Avisamos quem compartilha algum canal com esse usuário ANTES de
        # removê-lo dos canais, senão ele deixaria de ter algo "em comum" com eles
        for outra_conexao in obter_conexoes_em_comum(conexao):
            enviar_linha(outra_conexao, f":{conexao.nick} QUIT :Connection closed")

        sair_dos_canais(conexao)
        liberar_nick(conexao)

    if conexao in CONEXOES:
        CONEXOES.remove(conexao)

    conexao.fechar()


def dados_recebidos(conexao, dados):
    """Callback chamado sempre que novos bytes chegam pela conexão."""
    if dados == b'':
        return sair(conexao)

    # Junta os dados residuais de leituras anteriores com os dados que acabaram
    # de chegar, já que uma mensagem pode ter sido quebrada no meio
    conexao.residual += sanitize_string_data(dados)

    # Uma única leitura pode trazer várias linhas de uma vez; separamos por
    # '\r\n' e guardamos o último pedaço (que pode estar incompleto, ou vazio
    # se os dados terminarem exatamente em uma quebra de linha) para juntar
    # com a próxima leitura
    linhas = conexao.residual.split('\r\n')
    conexao.residual = linhas.pop()

    for linha in linhas:
        processar_linha(conexao, linha)


def conexao_aceita(conexao):
    """Callback chamado quando uma nova conexão TCP é estabelecida."""
    print(conexao, 'nova conexão')

    # Estado inicial: ainda não registrada (nick == '*'), sem canais e sem
    # dados residuais de leituras anteriores
    conexao.nick = '*'
    conexao.canais = set()
    conexao.residual = ''

    # Callback de recebimento de dados
    # e adiciona a conexão à lista global de conexões abertas
    conexao.registrar_recebedor(dados_recebidos)
    CONEXOES.append(conexao)


servidor = Servidor(6667)
servidor.registrar_monitor_de_conexoes_aceitas(conexao_aceita)
asyncio.get_event_loop().run_forever()
